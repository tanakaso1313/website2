# Stripe API Keys
# Get these from: https://dashboard.stripe.com/apikeys
# CRITICAL: Never commit actual keys to version control
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Amplitude Analytics API Key
# Get this from: https://amplitude.com
# WARNING: This key can be abused to inject fake analytics events
AMPLITUDE_API_KEY=your_amplitude_api_key_here

# CORS Allowed Origins (comma-separated)
# Set to your production domain(s)
CORS_ALLOWED_ORIGINS=https://sotanaka.com,https://www.sotanaka.com
